#!/bin/bash
# Builds the Folio package for Omarchy A (Arch Linux ARM, aarch64) inside a
# container and leaves it, with its checksum, in dist/. The same script runs
# in CI and on a developer's machine:
#
#   podman run --rm -v "$PWD:/src" "$(cat pkgbuild/omarchy-a/image)" /src/pkgbuild/omarchy-a/build
#
# The recipe is Folio's own (pkgbuild/PKGBUILD) under another name,
# folio-touch, which provides folio and conflicts with it: Omarchy A
# lists upstream Omarchy's package repository, and a system update must not
# swap this build for upstream's folio, which has no touch mode yet. makepkg refuses to run as root, so the build
# happens as an unprivileged user on a copy of the tree, and the tests run
# there too, as that user and with a generated locale, as upstream's CI
# runs them.
set -euo pipefail
src=$(cd "$(dirname "$0")/../.." && pwd)
release=$(cat "$src/pkgbuild/omarchy-a/release")

# pacman confines its downloader with Landlock and a separate user, which a
# container does not allow; the container is the confinement here.
grep -q '^DisableSandboxFilesystem' /etc/pacman.conf \
    || sed -i '/^DownloadUser = /d; /^CheckSpace/a DisableSandboxFilesystem\nDisableSandboxSyscalls' /etc/pacman.conf

# The image ships without pacman's signing keys set up.
if [ ! -d /etc/pacman.d/gnupg ]; then
    pacman-key --init
    pacman-key --populate archlinuxarm
fi

# The rolling repositories move under a pinned image: sync fully, never
# partially (only the kernel and firmware, unused in a container, stay
# behind). A mirror can fail; pacman moves to the next one, and we retry.
for attempt in 1 2 3; do
    pacman -Syu --noconfirm --needed --ignore 'linux-aarch64,linux-firmware*' \
        base-devel cmake dbus glib2 libarchive zlib xdg-utils hicolor-icon-theme \
        qt6-base qt6-declarative qt6-imageformats qt6-multimedia qt6-svg qt6-wayland ttf-dejavu && break
    [ "$attempt" -lt 3 ] || { echo "pacman failed three times" >&2; exit 1; }
    sleep 10
done
sed -i 's/^#en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen
locale-gen >/dev/null

id build >/dev/null 2>&1 || useradd -m build
work=/home/build/folio
rm -rf "$work"
mkdir -p "$work"
tar -C "$src" --exclude=./build --exclude=./dist --exclude=./.git -cf - . | tar -C "$work" -xf -
sed -i "s/^pkgname=.*/pkgname=folio-touch\nprovides=('folio')\nconflicts=('folio')/; s/^pkgrel=.*/pkgrel=$release/" "$work/pkgbuild/PKGBUILD"
chown -R build:build "$work"

su build -c "cd '$work' && LANG=en_US.UTF-8 dbus-run-session -- bin/test"

# One timestamp for every file in the package: the commit's, when known.
epoch=${SOURCE_DATE_EPOCH:-$(git -C "$src" -c safe.directory='*' log -1 --format=%ct 2>/dev/null || date +%s)}
su build -c "cd '$work/pkgbuild' && SOURCE_DATE_EPOCH=$epoch PKGEXT=.pkg.tar.zst makepkg --noconfirm --force --nodeps"

mkdir -p "$src/dist"
rm -f "$src"/dist/folio-*.pkg.tar.zst "$src/dist/SHA256SUMS"
cp "$work"/pkgbuild/folio-touch-*.pkg.tar.zst "$src/dist/"
(cd "$src/dist" && sha256sum folio-touch-*.pkg.tar.zst > SHA256SUMS && cat SHA256SUMS)
